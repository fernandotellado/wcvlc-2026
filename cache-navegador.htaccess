# ---------------------------------------------------------------------
# Caché del navegador · Diapositiva 35 · El cliente habitual
# Charla «Optimización web (avanzada) para pobres» · WordCamp Valencia 2026
#
# Para servidores Apache o LiteSpeed. En Nginx no hay .htaccess: pídeselo
# a tu hosting.
#
# Antes de pegarlo, comprueba que no lo hace ya Cloudflare o tu hosting
# (norma de la casa: cada cosa, una sola vez). Mira las cabeceras de una
# imagen o un CSS en la pestaña Red de las herramientas del navegador:
# si ya trae «Cache-Control: max-age=...» largo, no hace falta.
#
# Pégalo en el .htaccess de la raíz de WordPress, FUERA del bloque
# «# BEGIN WordPress ... # END WordPress», que WordPress lo reescribe.
# Haz una copia del .htaccess antes de tocarlo.
# ---------------------------------------------------------------------

<IfModule mod_expires.c>
	ExpiresActive On

	# El HTML no se guarda: así el visitante siempre ve la versión actual.
	ExpiresByType text/html "access plus 0 seconds"

	# Imágenes
	ExpiresByType image/avif "access plus 1 year"
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/gif "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType image/x-icon "access plus 1 week"

	# Estilos y scripts (WordPress les añade ?ver=, así que al actualizar
	# cambia la URL y el navegador descarga la versión nueva)
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType text/javascript "access plus 1 year"

	# Fuentes
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType font/woff "access plus 1 year"
	ExpiresByType font/ttf "access plus 1 year"
	ExpiresByType application/font-woff2 "access plus 1 year"

	# Vídeo y audio
	ExpiresByType video/mp4 "access plus 1 year"
	ExpiresByType video/webm "access plus 1 year"
	ExpiresByType audio/mpeg "access plus 1 year"
</IfModule>
